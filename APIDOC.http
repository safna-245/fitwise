Accept: application/json
Authorization: Token f0a449fefb1dfc6e28382de24baf3f1bda7849e3


#api call for create foodlog
###
POST http://127.0.0.1:8000/v1/foods/foodlogs/
Content-Type: application/json
Authorization:Token f0a449fefb1dfc6e28382de24baf3f1bda7849e3


{
    "title": "Egg",
    "calorie": 105,
    "meal_type": "SNACK",
    "serving_size": "1 piece"
}

#api call for fetch foodlog
###
GET http://127.0.0.1:8000/v1/foods/foodlogs/4/
Accept: application/json
Authorization: Token f0a449fefb1dfc6e28382de24baf3f1bda7849e3

#api call for update foodlog
###
PUT http://127.0.0.1:8000/v1/foods/foodlogs/5/
